FROM python:3.12-slim
WORKDIR /app
COPY illustration_pipeline/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home app && mkdir /data && chown app:app /data
COPY illustration_pipeline/ ./
USER app
ENV WORKBENCH_DATA=/data PYTHONUNBUFFERED=1
EXPOSE 5691
CMD ["python","workbench.py","--host","0.0.0.0"]
