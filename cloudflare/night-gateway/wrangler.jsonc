{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-for-two-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "vars": {
    "NIGHT_ORIGIN_HOST": "",
    "NIGHT_ORIGIN_PORT": "5681"
  },
  "vpc_networks": [
    {
      "binding": "APP_VPC",
      "tunnel_id": "SET_IN_CLOUDFLARE",
      "remote": true
    }
  ]
}
