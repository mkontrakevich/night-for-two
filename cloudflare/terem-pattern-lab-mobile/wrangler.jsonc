{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terem-pattern-lab-mobile",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
