{
  "schema_version": "1.0.0",
  "project": "TEREM Visual DNA",
  "target_action": "Generate new decorative patterns from accepted TEREM Visual DNA without presenting derived output as a historical original",
  "pipeline": [
    "SOURCE",
    "DNA",
    "RULES",
    "GENERATE"
  ],
  "fidelity_levels": {
    "SOURCE": "Directly extracted from rectified source imagery",
    "RECONSTRUCTED": "Mechanically restored/vectorized from SOURCE without invented historical detail",
    "DERIVED": "New repeat or composition assembled only from accepted DNA assets"
  },
  "historical_policy": {
    "generated_output_attribution": "UNKNOWN",
    "rule": "A generated pattern is never described as a historical original unless independently confirmed by an authoritative museum source.",
    "ai_inpainting_source_or_reconstructed": false
  },
  "room_profiles": [
    {
      "code": "STAIRCASE_CHURCHES",
