      "name": "Переходные палаты",
      "preferred_category": "01_FLORAL"
    },
    {
      "code": "DUMA_CHAMBER",
      "name": "Думная палата",
      "preferred_category": "02_GEOMETRIC_INTERLACE"
    },
    {
      "code": "THRONE_CHAMBER",
      "name": "Престольная палата",
      "preferred_category": "05_GOLD_ELEMENTS"
    },
    {
      "code": "TSAR_BEDCHAMBER",
      "name": "Опочивальня",
      "preferred_category": "01_FLORAL"
    }
  ],
  "motif_families": [
    {
      "code": "01_FLORAL",
      "name": "Орнаменты",
      "default_repeat": "half_drop"
    },
    {
      "code": "02_GEOMETRIC_INTERLACE",
      "name": "Геометрия",
      "default_repeat": "mirror"
    },
    {
      "code": "03_BORDERS_FRAMES",
      "name": "Бордюры",
      "default_repeat": "border"
    },
    {
      "code": "04_ROSETTES_MEDALLIONS",
      "name": "Розетки",
      "default_repeat": "radial"
    },
    {
      "code": "05_GOLD_ELEMENTS",
      "name": "Золото",
      "default_repeat": "mirror"
    },
    {
      "code": "06_TILES_STOVES",
      "name": "Изразцы",
      "default_repeat": "straight"
    },
    {
      "code": "07_WOOD_DOORS",
      "name": "Дерево",
      "default_repeat": "mirror"
    },
    {
      "code": "08_TEXTILE",
      "name": "Текстиль",
      "default_repeat": "half_drop"
    }
  ],
  "composition_sequence": [
    "ARCHITECTURAL_FRAME",
    "BORDER",
    "PRIMARY_FIELD",
    "RAPPORT",
    "CENTRAL_ELEMENT",
    "GOLD_HIERARCHY_ACCENT"
  ],
  "generator_modes": {
    "rapport": {
      "label": "Раппорт",
      "allowed_repeats": [
        "straight",
        "mirror",
        "half_drop"
      ]
    },
    "mirror": {
      "label": "Зеркальная система",
      "allowed_repeats": [
        "mirror"
      ]
    },
    "half_drop": {
      "label": "Полусдвиг",
      "allowed_repeats": [
        "half_drop"
      ]
    },
    "radial": {
      "label": "Радиальная композиция",
      "allowed_repeats": [
        "radial"
      ],
      "segments": [
        4,
        8,
        12
      ]
    },
    "border": {
      "label": "Бордюр / рама",
      "allowed_repeats": [
        "border",
        "mirror"
      ]
    }
  },
  "constraints": [
    "Use only assets that passed the production quality gate",
    "Preserve source color by default",
    "Do not invent heraldry, inscriptions, iconography or historical symbols",
    "Do not claim museum or period attribution for DERIVED output",
    "Every generated result must retain source asset identity and generation recipe"
  ],
  "generator_contract": {
    "inputs": [
      "room",
      "category",
      "source_asset",
      "composition",
      "density",
      "scale",
      "symmetry"
    ],
    "outputs": [
      "preview_png",
      "recipe_json",
      "source_asset_reference",
      "fidelity=DERIVED",
      "historical_attribution=UNKNOWN"
    ]
  }
}
