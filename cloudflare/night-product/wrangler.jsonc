{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-for-two",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "NIGHT_ORIGIN_HOST": "",
    "NIGHT_ORIGIN_PORT": "5683"
  },
  "vpc_networks": [
    {
      "binding": "NIGHT_VPC",
      "tunnel_id": "SET_IN_CLOUDFLARE",
      "remote": true
    }
  ]
}
